# Copy to .env and adjust.
# Connection role must be able to CREATE ROLE on first migrate (creates NOLOGIN role "stallion_rls").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stallioncrm?schema=public"

# Auth.js – generate with: npx auth secret
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true

# Optional Microsoft Entra ID SSO (leave empty to disable). Users must already exist (matched by email).
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Mail (Mailpit from docker-compose)
SMTP_URL="smtp://localhost:1025"

LOG_LEVEL="info"

# Attachments: local disk by default (./.local/uploads). Set these for S3-compatible storage (AWS S3, MinIO, R2).
STORAGE_DIR=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public web-to-lead form (optional)
RECAPTCHA_SECRET_KEY=""
WEB_LEAD_RATE_LIMIT="10"

# Scheduler secret for POST /api/public/cron/tick (workflow rules, jobs, reminders, auto-approvals). Empty = disabled.
CRON_SECRET=""

# HMAC-SHA256 secret for the X-Stallion-Signature header of workflow webhooks (optional).
WEBHOOK_SECRET=""
# Set to 0 to run workflow jobs only from the cron tick (default: also right after the triggering request).
JOBS_INLINE=""

# ── Messaging (prompt 10). Without configuration every channel uses the sandbox adapter (nothing is delivered). ──
# Sender identities are set per brand in Setup → Brands; only provider credentials live here.
EMAIL_PROVIDER=""            # smtp | graph
SMTP_URL=""                  # smtps://user:password@smtp.example.com:465
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
SMS_PROVIDER=""              # termii | africastalking
TERMII_API_KEY=""
AT_USERNAME=""
AT_API_KEY=""
WHATSAPP_PROVIDER=""         # cloud
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""       # verifies Meta's webhook signature
WHATSAPP_VERIFY_TOKEN=""     # webhook subscription check
MESSAGING_WEBHOOK_SECRET=""  # token for /api/public/webhooks/sms and /email (empty = disabled)
MESSAGING_RATE_PER_MINUTE="120"
APP_URL=""                   # public base URL, used in unsubscribe links
MAIL_FROM=""                 # sender of emails to CRM users when no brand applies
NOTIFICATION_EMAILS=""       # 1 = also email reminders, mentions, assignments and approvals

# Exports up to this many rows download directly; larger ones run as a background job (default 2000)
EXPORT_SYNC_LIMIT=""

# ── API, webhooks & integrations (prompt 13) – everything is OFF while unset ──
# Public URL of the application (OpenAPI server URL, payment callback)
APP_URL=""
# ERP per legal entity: NAME_<BRANDCODE> overrides NAME. Adapter: business-central | zoho-books | csv
ERP_ADAPTER=""
ERP_BASE_URL=""
ERP_TOKEN=""
# Shared secret of POST /api/public/webhooks/erp (payment reconciliation)
ERP_WEBHOOK_SECRET=""
# Online payments per brand, e.g. PAYSTACK_SECRET_KEY_HMNL
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""
# Development / tests only: allow webhook receivers on private addresses (ignored in production)
WEBHOOK_ALLOW_PRIVATE=""

# ── Mobile & notifications (prompt 14) ──
# Web push (off while unset). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:crm@example.com"

# ── Security & operations (prompt 15) ──
# Staff sign in with Microsoft Entra ID only; password sign-in stays possible for the break-glass addresses
AUTH_SSO_ONLY=""
AUTH_PASSWORD_LOGIN_ALLOW=""
# Sentry-compatible error tracking (off while unset)
SENTRY_DSN=""
APP_RELEASE=""
