{
  "name": "stallioncrm",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-brand automotive sales CRM with brand isolation (Zoho CRM replacement)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:isolation": "vitest run --project isolation",
    "test:idor": "playwright test --project=e2e tests/e2e/zz-idor.spec.ts",
    "test:watch": "vitest",
    "e2e": "playwright test --project=e2e",
    "backup:decrypt": "node --import tsx scripts/decrypt-backup.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:local": "tsx scripts/local-db.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:new-migration": "tsx scripts/migrate-dev.ts",
    "postinstall": "prisma generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "e2e:visual": "playwright test --project=visual",
    "build:vercel": "node scripts/vercel-build.mjs",
    "ui:compare": "playwright test --project=compare",
    "setup:catalogue": "tsx scripts/setup-catalogue.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "~6.19.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "15.5.27",
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prisma": "~6.19.3",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "embedded-postgres",
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64"
    ]
  }
}
