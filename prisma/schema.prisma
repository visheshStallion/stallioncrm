// StallionCRM – core data model (prompt 00).
// Later modules extend this file. Every BRAND-OWNED model MUST:
//   1. include the base mixin fields below (brandId, regionId, territoryId, ownerId,
//      createdById, updatedById, createdAt, updatedAt, deletedAt), and
//   2. get RLS enabled in its migration: SELECT app_enable_brand_rls('"<Model>"');
// The access engine detects brand-owned models automatically (brandId + regionId + ownerId),
// and tests/integration/rls-coverage.test.ts fails if RLS is missing on any of them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Organisation ───────────────────────────────

enum BrandStatus {
  ACTIVE
  FUTURE
  INACTIVE
}

model Brand {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String
  legalEntity    String?
  erpCompanyCode String?
  docPrefix      String?
  logoUrl        String?
  /// Uploaded logo (small image, served by /api/v1/brands/[id]/logo). Takes precedence over logoUrl.
  logoData       Bytes?
  logoMimeType   String?
  /// Hex colour used by BrandBadge (e.g. "#1d4ed8"). Falls back to a palette when null.
  color          String?
  status         BrandStatus @default(ACTIVE)
  brandManagerId String?
  brandManager   User?       @relation("BrandManager", fields: [brandManagerId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  aliases         BrandCodeAlias[]
  territories     Territory[]
  deals           Deal[]
  leads           Lead[]
  products        Product[]
  assignmentRules AssignmentRule[]
}

/// Legacy company codes (e.g. from the HR rep file) mapped to a brand. Configurable, never hard-coded.
model BrandCodeAlias {
  alias   String  @id
  brandId String
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  note    String?

  @@index([brandId])
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  territories     Territory[]
  deals           Deal[]
  leads           Lead[]
  assignmentRules AssignmentRule[]
}

/// Territory tree: level 0 = Group root, level 1 = Brand, level 2 = "BRAND – Region".
model Territory {
  id        String      @id @default(cuid())
  name      String      @unique
  level     Int
  parentId  String?
  parent    Territory?  @relation("TerritoryTree", fields: [parentId], references: [id])
  children  Territory[] @relation("TerritoryTree")
  brandId   String?
  brand     Brand?      @relation(fields: [brandId], references: [id])
  regionId  String?
  region    Region?     @relation(fields: [regionId], references: [id])
  managerId String?
  manager   User?       @relation("TerritoryManager", fields: [managerId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  members TerritoryMember[]
  deals   Deal[]
  leads   Lead[]

  @@unique([brandId, regionId])
  @@index([parentId])
}

model Role {
  id           String  @id @default(cuid())
  name         String  @unique
  parentRoleId String?
  parentRole   Role?   @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles   Role[]  @relation("RoleHierarchy")
  users        User[]
}

enum ProfileScope {
  ALL
  TERRITORY
}

model Profile {
  id               String       @id @default(cuid())
  name             String       @unique
  scope            ProfileScope @default(TERRITORY)
  /// module → { read, create, edit, delete, export, massUpdate, approve }
  permissions      Json         @default("{}")
  /// module → field → "hidden" | "masked" | "read" | "edit"
  fieldPermissions Json         @default("{}")
  users            User[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// argon2id hash; null for SSO-only users
  passwordHash String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id])
  active       Boolean  @default(true)
  managerId    String?
  manager      User?    @relation("UserManager", fields: [managerId], references: [id])
  reports      User[]   @relation("UserManager")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        TerritoryMember[]
  managedBrands      Brand[]           @relation("BrandManager")
  managedTerritories Territory[]       @relation("TerritoryManager")
  ownedDeals         Deal[]            @relation("DealOwner")
  createdDeals       Deal[]            @relation("DealCreatedBy")
  updatedDeals       Deal[]            @relation("DealUpdatedBy")
  auditLogs          AuditLog[]
  ownedLeads         Lead[]            @relation("LeadOwner")
  createdLeads       Lead[]            @relation("LeadCreatedBy")
  updatedLeads       Lead[]            @relation("LeadUpdatedBy")
  savedViews         SavedView[]
  assignmentRules    AssignmentRule[]
  userPreferences    UserPreference[]
}

model TerritoryMember {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  isManager   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@id([userId, territoryId])
  @@index([territoryId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EXPORT
  LOGIN
  LOGIN_FAILED
  LOGOUT
  IMPORT
}

model AuditLog {
  id       String      @id @default(cuid())
  at       DateTime    @default(now())
  userId   String?
  user     User?       @relation(fields: [userId], references: [id])
  action   AuditAction
  entity   String
  entityId String?
  brandId  String?
  before   Json?
  after    Json?
  ip       String?

  @@index([entity, entityId])
  @@index([userId, at])
  @@index([brandId, at])
}

// ─────────────────────────── Brand-owned records ───────────────────────────

enum DealStage {
  ENQUIRY
  TEST_DRIVE
  QUOTATION
  BOOKING
  FINANCE_PAYMENT
  DELIVERY
  CLOSED_WON
  CLOSED_LOST
}

/// Minimal Deal used by the foundation to demonstrate isolation. Prompt 04 extends it.
model Deal {
  id                String    @id @default(cuid())
  name              String
  customerName      String?
  amount            Decimal?  @db.Decimal(14, 2)
  stage             DealStage @default(ENQUIRY)
  closeDate         DateTime?
  /// Shared customer (prompt 03) and model (prompt 05).
  accountId         String?
  account           Account?  @relation(fields: [accountId], references: [id])
  contactId         String?
  contact           Contact?  @relation(fields: [contactId], references: [id])
  modelId           String?
  model             Product?  @relation("DealModel", fields: [modelId], references: [id])
  convertedFromLead Lead?

  // ── brand-owned base mixin ──
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region     @relation(fields: [regionId], references: [id])
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id])
  ownerId     String
  owner       User       @relation("DealOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?      @relation("DealCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?      @relation("DealUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([brandId, regionId])
  @@index([ownerId])
}

// ─────────────────────────── Shared customers (minimal) ───────────────────────────
// Prompt 03 extends Account / Contact (KYC, address, dedupe, field tiers). Customers are SHARED across brands.

enum AccountType {
  INDIVIDUAL
  COMPANY
}

model Account {
  id          String      @id @default(cuid())
  name        String
  type        AccountType @default(INDIVIDUAL)
  city        String?
  phone       String?
  email       String?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  contacts Contact[]
  deals    Deal[]

  @@index([phone])
  @@index([email])
}

model Contact {
  id          String   @id @default(cuid())
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  firstName   String?
  lastName    String
  mobile      String?
  email       String?
  city        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals          Deal[]
  convertedLeads Lead[]

  @@index([mobile])
  @@index([email])
}

// ─────────────────────────── Catalogue (minimal) ───────────────────────────
// Prompt 05 extends Product (variants, prices, price books). Brand-tagged, not brand-owned.

model Product {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads           Lead[]
  deals           Deal[]           @relation("DealModel")
  assignmentRules AssignmentRule[]

  @@unique([brandId, code])
}

// ─────────────────────────────────── Leads ───────────────────────────────────

enum LeadSource {
  WALK_IN
  WEBSITE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  REFERRAL
  FLEET_CORPORATE
  EVENT
  PHONE
}

enum PaymentIntent {
  CASH
  BANK_FINANCE
  LEASE
  FLEET
}

enum PurchaseWindow {
  M0_1
  M1_3
  M3_6
  M6_PLUS
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadRating {
  HOT
  WARM
  COLD
}

/// Brand-owned lead (prompt 02).
model Lead {
  id                     String          @id @default(cuid())
  firstName              String?
  lastName               String
  /// E.164, Nigeria (+234) default
  mobile                 String?
  email                  String?
  city                   String?
  source                 LeadSource      @default(WALK_IN)
  sourceDetail           String?
  /// utm_source / utm_medium / utm_campaign / utm_term / utm_content / referrer
  utm                    Json?
  modelOfInterestId      String?
  modelOfInterest        Product?        @relation(fields: [modelOfInterestId], references: [id])
  budget                 Decimal?        @db.Decimal(14, 2)
  paymentIntent          PaymentIntent?
  tradeIn                Boolean         @default(false)
  tradeInNotes           String?
  expectedPurchaseWindow PurchaseWindow?
  status                 LeadStatus      @default(NEW)
  unqualifiedReason      String?
  rating                 LeadRating?
  consentMarketing       Boolean         @default(false)
  consentAt              DateTime?
  convertedDealId        String?         @unique
  convertedDeal          Deal?           @relation(fields: [convertedDealId], references: [id])
  convertedContactId     String?
  convertedContact       Contact?        @relation(fields: [convertedContactId], references: [id])
  convertedAt            DateTime?

  // ── brand-owned base mixin ──
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region     @relation(fields: [regionId], references: [id])
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id])
  ownerId     String
  owner       User       @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?      @relation("LeadCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?      @relation("LeadUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([brandId, regionId])
  @@index([ownerId])
  @@index([status])
  @@index([mobile])
  @@index([email])
}

/// Saved list views per user and module ("My open leads", …).
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  name      String
  /// filter state (status, source, brandId, regionId, ownerId, from, to, …)
  filters   Json     @default("{}")
  /// visible column ids, in order
  columns   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module, name])
}

enum AssignmentAction {
  ROUND_ROBIN
  SPECIFIC_USER
  TERRITORY_MANAGER
}

/// Ordered assignment rules (/admin/assignment-rules/leads). First active match wins.
model AssignmentRule {
  id        String           @id @default(cuid())
  module    String           @default("leads")
  name      String
  position  Int
  active    Boolean          @default(true)
  // criteria (null = any)
  brandId   String?
  brand     Brand?           @relation(fields: [brandId], references: [id])
  regionId  String?
  region    Region?          @relation(fields: [regionId], references: [id])
  source    LeadSource?
  productId String?
  product   Product?         @relation(fields: [productId], references: [id])
  // action
  action    AssignmentAction @default(ROUND_ROBIN)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  /// persisted round-robin pointer
  rrPointer Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([module, position])
}

/// Per-user UI preferences (prompt 17): module rail order/pins, theme, density, date format, column layouts.
model UserPreference {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}
