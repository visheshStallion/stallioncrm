// StallionCRM – core data model (prompt 00).
// Later modules extend this file. Every BRAND-OWNED model MUST:
//   1. include the base mixin fields below (brandId, regionId, territoryId, ownerId,
//      createdById, updatedById, createdAt, updatedAt, deletedAt), and
//   2. get RLS enabled in its migration: SELECT app_enable_brand_rls('"<Model>"');
// The access engine detects brand-owned models automatically (brandId + regionId + ownerId),
// and tests/integration/rls-coverage.test.ts fails if RLS is missing on any of them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Organisation ───────────────────────────────

enum BrandStatus {
  ACTIVE
  FUTURE
  INACTIVE
}

model Brand {
  id                    String      @id @default(cuid())
  code                  String      @unique
  name                  String
  legalEntity           String?
  erpCompanyCode        String?
  docPrefix             String?
  logoUrl               String?
  /// Uploaded logo (small image, served by /api/v1/brands/[id]/logo). Takes precedence over logoUrl.
  logoData              Bytes?
  logoMimeType          String?
  /// Hex colour used by BrandBadge (e.g. "#1d4ed8"). Falls back to a palette when null.
  color                 String?
  status                BrandStatus @default(ACTIVE)
  /// Printed on quotes / orders / invoices (PDF templates per brand)
  address               String?
  bankDetails           String?
  documentTerms         String?
  /// Discount above this % needs Brand Manager approval; above the escalation % Head of Sales (BUSINESS_CONTEXT §10)
  discountApprovalPct   Decimal     @default(3) @db.Decimal(5, 2)
  discountEscalationPct Decimal     @default(7) @db.Decimal(5, 2)
  brandManagerId        String?
  brandManager          User?       @relation("BrandManager", fields: [brandManagerId], references: [id])
  // ── sender identity (prompt 10): a message about this brand's record is always sent as this brand ──
  fromName              String?
  fromEmail             String?
  /// alphanumeric SMS sender ID (max 11 characters)
  smsSenderId           String?
  /// number that receives inbound SMS for this brand (E.164 or short code)
  smsInboundNumber      String?     @unique
  /// WhatsApp Business number (E.164) and its Cloud API phone-number id
  whatsappNumber        String?     @unique
  whatsappPhoneId       String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  aliases           BrandCodeAlias[]
  territories       Territory[]
  deals             Deal[]
  leads             Lead[]
  products          Product[]
  assignmentRules   AssignmentRule[]
  customerLinks     CustomerBrandLink[]
  pipelines         Pipeline[]
  priceBooks        PriceBook[]
  quotes            Quote[]
  salesOrders       SalesOrder[]
  invoices          Invoice[]
  approvalRequests  ApprovalRequest[]
  activities        Activity[]
  stockRefs         VehicleStockRef[]
  notes             Note[]
  attachments       Attachment[]
  contactConsents   ContactBrandConsent[]
  approvalProcesses ApprovalProcess[]
  workflowRules     WorkflowRule[]
  reports           Report[]
  targets           Target[]
  forecastNotes     ForecastNote[]
  messages          Message[]
  templates         Template[]
  campaigns         Campaign[]
  cases             Case[]
  slaPolicies       SlaPolicy[]
  solutions         Solution[]
}

/// Legacy company codes (e.g. from the HR rep file) mapped to a brand. Configurable, never hard-coded.
model BrandCodeAlias {
  alias   String  @id
  brandId String
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  note    String?

  @@index([brandId])
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  territories      Territory[]
  deals            Deal[]
  leads            Lead[]
  notes            Note[]
  quotes           Quote[]
  salesOrders      SalesOrder[]
  invoices         Invoice[]
  approvalRequests ApprovalRequest[]
  activities       Activity[]
  attachments      Attachment[]
  assignmentRules  AssignmentRule[]
  targets          Target[]
  messages         Message[]
  cases            Case[]
}

/// Territory tree: level 0 = Group root, level 1 = Brand, level 2 = "BRAND – Region".
model Territory {
  id        String      @id @default(cuid())
  name      String      @unique
  level     Int
  parentId  String?
  parent    Territory?  @relation("TerritoryTree", fields: [parentId], references: [id])
  children  Territory[] @relation("TerritoryTree")
  brandId   String?
  brand     Brand?      @relation(fields: [brandId], references: [id])
  regionId  String?
  region    Region?     @relation(fields: [regionId], references: [id])
  managerId String?
  manager   User?       @relation("TerritoryManager", fields: [managerId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  members TerritoryMember[]
  deals   Deal[]
  leads   Lead[]

  @@unique([brandId, regionId])
  @@index([parentId])
}

model Role {
  id           String  @id @default(cuid())
  name         String  @unique
  parentRoleId String?
  parentRole   Role?   @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles   Role[]  @relation("RoleHierarchy")
  users        User[]
}

enum ProfileScope {
  ALL
  TERRITORY
}

model Profile {
  id               String       @id @default(cuid())
  name             String       @unique
  scope            ProfileScope @default(TERRITORY)
  /// module → { read, create, edit, delete, export, massUpdate, approve }
  permissions      Json         @default("{}")
  /// module → field → "hidden" | "masked" | "read" | "edit"
  fieldPermissions Json         @default("{}")
  users            User[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// argon2id hash; null for SSO-only users
  passwordHash String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id])
  active       Boolean  @default(true)
  managerId    String?
  manager      User?    @relation("UserManager", fields: [managerId], references: [id])
  reports      User[]   @relation("UserManager")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        TerritoryMember[]
  managedBrands      Brand[]           @relation("BrandManager")
  managedTerritories Territory[]       @relation("TerritoryManager")
  ownedDeals         Deal[]            @relation("DealOwner")
  createdDeals       Deal[]            @relation("DealCreatedBy")
  updatedDeals       Deal[]            @relation("DealUpdatedBy")
  auditLogs          AuditLog[]
  ownedLeads         Lead[]            @relation("LeadOwner")
  createdLeads       Lead[]            @relation("LeadCreatedBy")
  updatedLeads       Lead[]            @relation("LeadUpdatedBy")
  savedViews         SavedView[]
  ownedAccounts      Account[]         @relation("AccountOwner")
  ownedContacts      Contact[]         @relation("ContactOwner")
  ownedNotes         Note[]            @relation("NoteOwner")
  ownedQuotes        Quote[]           @relation("QuoteOwner")
  ownedSalesOrders   SalesOrder[]      @relation("SalesOrderOwner")
  ownedInvoices      Invoice[]         @relation("InvoiceOwner")
  requestedApprovals ApprovalRequest[] @relation("ApprovalOwner")
  approvalsToDecide  ApprovalRequest[] @relation("ApprovalApprover")
  ownedActivities    Activity[]        @relation("ActivityOwner")
  notifications      Notification[]
  ownedAttachments   Attachment[]      @relation("AttachmentOwner")
  assignmentRules    AssignmentRule[]
  userPreferences    UserPreference[]
  approvalTasks      ApprovalTask[]    @relation("ApprovalTaskApprover")
  savedReports       Report[]
  targets            Target[]          @relation("TargetUser")
  forecastNotes      ForecastNote[]
  ownedMessages      Message[]         @relation("MessageOwner")
  ownedCases         Case[]            @relation("CaseOwner")
}

model TerritoryMember {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  isManager   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@id([userId, territoryId])
  @@index([territoryId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EXPORT
  LOGIN
  LOGIN_FAILED
  LOGOUT
  IMPORT
}

model AuditLog {
  id       String      @id @default(cuid())
  at       DateTime    @default(now())
  userId   String?
  user     User?       @relation(fields: [userId], references: [id])
  action   AuditAction
  entity   String
  entityId String?
  brandId  String?
  before   Json?
  after    Json?
  ip       String?

  @@index([entity, entityId])
  @@index([userId, at])
  @@index([brandId, at])
}

// ─────────────────────────── Brand-owned records ───────────────────────────

enum StageType {
  OPEN
  WON
  LOST
}

/// One sales pipeline per brand (more can be added). The default one is created by a DB trigger with the brand.
model Pipeline {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages PipelineStage[]
  deals  Deal[]

  @@unique([brandId, name])
}

model PipelineStage {
  id                 String    @id @default(cuid())
  pipelineId         String
  pipeline           Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  /// stable key within the pipeline (ENQUIRY, TEST_DRIVE, …)
  key                String
  name               String
  order              Int
  /// win probability in percent
  probability        Int       @default(0)
  type               StageType @default(OPEN)
  /// Blueprint: requirement keys that must be satisfied to ENTER this stage (see deals/blueprint.ts)
  requiredFields     Json      @default("[]")
  /// stage keys reachable from this stage; null = default rule (previous / next / lost)
  allowedTransitions Json?
  maxDaysInStage     Int?

  deals Deal[]

  @@unique([pipelineId, key])
  @@index([pipelineId, order])
}

/// Brand-owned deal (prompt 04). pipelineId / stageId are always set – a DB trigger fills the brand's default
/// pipeline and first stage when omitted and rejects a pipeline of another brand.
model Deal {
  id                  String         @id @default(cuid())
  name                String
  customerName        String?
  amount              Decimal?       @db.Decimal(14, 2)
  currency            String         @default("NGN")
  /// expected close date
  closeDate           DateTime?
  pipelineId          String?
  pipeline            Pipeline?      @relation(fields: [pipelineId], references: [id])
  stageId             String?
  stage               PipelineStage? @relation(fields: [stageId], references: [id])
  stageEnteredAt      DateTime       @default(now())
  /// Shared customer (prompt 03)
  accountId           String?
  account             Account?       @relation(fields: [accountId], references: [id])
  contactId           String?
  contact             Contact?       @relation(fields: [contactId], references: [id])
  /// Model / variant of the deal's brand (prompt 05)
  modelId             String?
  model               Product?       @relation("DealModel", fields: [modelId], references: [id])
  quantity            Int            @default(1)
  colour              String?
  paymentType         PaymentIntent?
  financeBank         String?
  tradeInDetails      String?
  discountPct         Decimal?       @db.Decimal(5, 2)
  testDriveDate       DateTime?
  depositAmount       Decimal?       @db.Decimal(14, 2)
  depositReceiptNo    String?
  vinChassisNo        String?
  engineNo            String?
  deliveryDate        DateTime?
  lossReason          String?
  lossCompetitorBrand String?
  /// Campaign (prompt 10)
  campaignId          String?
  convertedFromLead   Lead?

  // ── brand-owned base mixin ──
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region     @relation(fields: [regionId], references: [id])
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id])
  ownerId     String
  owner       User       @relation("DealOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?      @relation("DealCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?      @relation("DealUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  stageHistory DealStageHistory[]
  quotes       Quote[]
  salesOrders  SalesOrder[]
  invoices     Invoice[]
  campaign     Campaign?          @relation(fields: [campaignId], references: [id])
  cases        Case[]

  /// VIN / chassis number is unique per brand
  @@unique([brandId, vinChassisNo])
  @@index([brandId, regionId])
  @@index([ownerId])
  @@index([stageId])
}

/// Written by the DB trigger app_deal_stage_history() on every stage change. RLS: visible when the deal is.
model DealStageHistory {
  id            String   @id @default(cuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStageId   String?
  toStageId     String
  at            DateTime @default(now())
  userId        String?
  /// hours spent in the previous stage
  durationHours Decimal? @db.Decimal(10, 2)

  @@index([dealId, at])
}

/// Note on any brand-owned record (entity + entityId). Brand-owned: inherits the parent's brand and region.
model Note {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  body     String
  /// user ids mentioned in the note (only users who can see the parent record)
  mentions String[] @default([])

  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  territoryId String?
  ownerId     String
  owner       User      @relation("NoteOwner", fields: [ownerId], references: [id])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([entity, entityId])
  @@index([brandId, regionId])
}

/// File attached to a brand-owned record. Bytes live in object storage (src/server/storage); access is brand-scoped.
model Attachment {
  id          String @id @default(cuid())
  entity      String
  entityId    String
  fileName    String
  contentType String
  size        Int
  storageKey  String @unique

  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  territoryId String?
  ownerId     String
  owner       User      @relation("AttachmentOwner", fields: [ownerId], references: [id])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([entity, entityId])
  @@index([brandId, regionId])
}

// ─────────────────────────── Shared customers (minimal) ───────────────────────────
// Prompt 03 extends Account / Contact (KYC, address, dedupe, field tiers). Customers are SHARED across brands.

enum AccountType {
  INDIVIDUAL
  CORPORATE
  GOVERNMENT
  FLEET
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

/// Shared customer (individual or organisation). NOT brand-owned – see docs/ARCHITECTURE.md "Customers".
model Account {
  id               String      @id @default(cuid())
  name             String
  type             AccountType @default(INDIVIDUAL)
  /// CAC registration number (corporate) – sensitive tier
  rcNumber         String?
  industry         String?
  city             String?
  state            String?
  address          String?
  phone            String?
  email            String?
  website          String?
  /// sensitive tier
  creditLimit      Decimal?    @db.Decimal(14, 2)
  kycStatus        KycStatus   @default(NOT_STARTED)
  notes            String?
  primaryContactId String?
  ownerId          String?
  owner            User?       @relation("AccountOwner", fields: [ownerId], references: [id])
  createdById      String?
  updatedById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  /// set when this record was merged into another (soft-deleted)
  mergedIntoId     String?

  contacts   Contact[]
  deals      Deal[]
  brandLinks CustomerBrandLink[]
  cases      Case[]

  @@index([phone])
  @@index([email])
  @@index([rcNumber])
  @@index([name])
}

model Contact {
  id               String    @id @default(cuid())
  accountId        String?
  account          Account?  @relation(fields: [accountId], references: [id])
  firstName        String?
  lastName         String
  mobile           String?
  altPhone         String?
  email            String?
  dateOfBirth      DateTime? @db.Date
  gender           String?
  city             String?
  address          String?
  /// PHONE | WHATSAPP | EMAIL | SMS
  preferredChannel String?
  ownerId          String?
  owner            User?     @relation("ContactOwner", fields: [ownerId], references: [id])
  createdById      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  mergedIntoId     String?

  deals           Deal[]
  convertedLeads  Lead[]
  consents        ContactBrandConsent[]
  campaignMembers CampaignMember[]
  cases           Case[]

  @@index([mobile])
  @@index([email])
  @@index([accountId])
}

/// Marketing consent is per brand: opting out of one brand does not opt out of another.
model ContactBrandConsent {
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  consent   Boolean
  at        DateTime @default(now())

  @@id([contactId, brandId])
}

/// Brands a customer has brand-owned records with. Maintained by the DB trigger app_link_customer().
model CustomerBrandLink {
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id])
  firstSeenAt DateTime @default(now())

  @@id([accountId, brandId])
  @@index([brandId])
}

// ─────────────────────────── Catalogue (minimal) ───────────────────────────
// Prompt 05 extends Product (variants, prices, price books). Brand-tagged, not brand-owned.

enum ProductCategory {
  VEHICLE
  ACCESSORY
  EXTENDED_WARRANTY
  SERVICE_PACKAGE
  INSURANCE
}

/// Brand-tagged master data (prompt 05): readable by users of the brand, editable by its Brand Manager and Admin.
/// scopedDb + RLS restrict it to the user's brands. Any brand-owned record may only reference products of ITS brand.
model Product {
  id           String          @id @default(cuid())
  brandId      String
  brand        Brand           @relation(fields: [brandId], references: [id])
  /// SKU, unique per brand
  code         String
  /// display name ("<model> <variant>")
  name         String
  category     ProductCategory @default(VEHICLE)
  model        String?
  variant      String?
  modelYear    Int?
  bodyType     String?
  fuel         String?
  transmission String?
  engineCc     Int?
  colours      String[]        @default([])
  /// list price in NGN
  listPrice    Decimal?        @db.Decimal(14, 2)
  taxCode      String          @default("VAT")
  taxRatePct   Decimal         @default(7.5) @db.Decimal(5, 2)
  imageUrls    String[]        @default([])
  specSheetUrl String?
  description  String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  leads           Lead[]
  deals           Deal[]            @relation("DealModel")
  assignmentRules AssignmentRule[]
  priceEntries    PriceBookEntry[]
  stock           VehicleStockRef[]
  documentLines   DocumentLine[]
  testDrives      TestDrive[]

  @@unique([brandId, code])
  @@index([brandId, active])
}

model PriceBook {
  id        String    @id @default(cuid())
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id])
  name      String
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  active    Boolean   @default(true)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entries PriceBookEntry[]

  @@unique([brandId, name])
}

model PriceBookEntry {
  id             String    @id @default(cuid())
  priceBookId    String
  priceBook      PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  /// must be a product of the price book's brand (enforced by trigger)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  price          Decimal   @db.Decimal(14, 2)
  /// used by discount approvals (prompt 08)
  maxDiscountPct Decimal?  @db.Decimal(5, 2)
  notes          String?

  @@unique([priceBookId, productId])
}

enum StockStatus {
  IN_TRANSIT
  IN_STOCK
  RESERVED
  SOLD
}

/// Lightweight VIN reference so deals can reserve a vehicle. Replaced by the inventory module (prompt 16).
model VehicleStockRef {
  id        String      @id @default(cuid())
  brandId   String
  brand     Brand       @relation(fields: [brandId], references: [id])
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  vin       String
  colour    String?
  location  String?
  status    StockStatus @default(IN_STOCK)
  /// reserving / selling deal
  dealId    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([brandId, vin])
  @@index([productId, status])
  @@index([dealId])
}

// ─────────────────────────────────── Leads ───────────────────────────────────

enum LeadSource {
  WALK_IN
  WEBSITE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  REFERRAL
  FLEET_CORPORATE
  EVENT
  PHONE
}

enum PaymentIntent {
  CASH
  BANK_FINANCE
  LEASE
  FLEET
}

enum PurchaseWindow {
  M0_1
  M1_3
  M3_6
  M6_PLUS
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadRating {
  HOT
  WARM
  COLD
}

/// Brand-owned lead (prompt 02).
model Lead {
  id                     String          @id @default(cuid())
  firstName              String?
  lastName               String
  /// E.164, Nigeria (+234) default
  mobile                 String?
  email                  String?
  city                   String?
  source                 LeadSource      @default(WALK_IN)
  sourceDetail           String?
  /// utm_source / utm_medium / utm_campaign / utm_term / utm_content / referrer
  utm                    Json?
  modelOfInterestId      String?
  modelOfInterest        Product?        @relation(fields: [modelOfInterestId], references: [id])
  budget                 Decimal?        @db.Decimal(14, 2)
  paymentIntent          PaymentIntent?
  tradeIn                Boolean         @default(false)
  tradeInNotes           String?
  expectedPurchaseWindow PurchaseWindow?
  status                 LeadStatus      @default(NEW)
  unqualifiedReason      String?
  rating                 LeadRating?
  consentMarketing       Boolean         @default(false)
  consentAt              DateTime?
  convertedDealId        String?         @unique
  convertedDeal          Deal?           @relation(fields: [convertedDealId], references: [id])
  convertedContactId     String?
  convertedContact       Contact?        @relation(fields: [convertedContactId], references: [id])
  convertedAt            DateTime?

  // ── brand-owned base mixin ──
  brandId         String
  brand           Brand            @relation(fields: [brandId], references: [id])
  regionId        String
  region          Region           @relation(fields: [regionId], references: [id])
  territoryId     String?
  territory       Territory?       @relation(fields: [territoryId], references: [id])
  ownerId         String
  owner           User             @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById     String?
  createdBy       User?            @relation("LeadCreatedBy", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?            @relation("LeadUpdatedBy", fields: [updatedById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  /// campaign that produced this lead (ROI)
  campaignId      String?
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  campaignMembers CampaignMember[]

  @@index([brandId, regionId])
  @@index([ownerId])
  @@index([status])
  @@index([mobile])
  @@index([email])
}

/// Saved list views per user and module ("My open leads", …).
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  name      String
  /// filter state (status, source, brandId, regionId, ownerId, from, to, …)
  filters   Json     @default("{}")
  /// visible column ids, in order
  columns   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module, name])
}

enum AssignmentAction {
  ROUND_ROBIN
  SPECIFIC_USER
  TERRITORY_MANAGER
}

/// Ordered assignment rules (/admin/assignment-rules/leads). First active match wins.
model AssignmentRule {
  id        String           @id @default(cuid())
  module    String           @default("leads")
  name      String
  position  Int
  active    Boolean          @default(true)
  // criteria (null = any)
  brandId   String?
  brand     Brand?           @relation(fields: [brandId], references: [id])
  regionId  String?
  region    Region?          @relation(fields: [regionId], references: [id])
  source    LeadSource?
  productId String?
  product   Product?         @relation(fields: [productId], references: [id])
  // action
  action    AssignmentAction @default(ROUND_ROBIN)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  /// persisted round-robin pointer
  rrPointer Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([module, position])
}

/// Per-user UI preferences (prompt 17): module rail order/pins, theme, density, date format, column layouts.
model UserPreference {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

// ───────────────────────── Quotes, Sales Orders & Invoices (prompt 06) ─────────────────────────

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  ALLOCATED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  VOID
}

model Quote {
  id                String      @id @default(cuid())
  /// {docPrefix}-{QT|SO|INV}-{YYYY}-{00001}; assigned by the DB trigger app_document_number() (gap-free per brand / type / year)
  number            String      @unique @default("")
  dealId            String
  deal              Deal        @relation(fields: [dealId], references: [id])
  accountId         String?
  contactId         String?
  issueDate         DateTime    @default(now()) @db.Date
  currency          String      @default("NGN")
  /// header discount in percent, applied after line discounts
  headerDiscountPct Decimal     @default(0) @db.Decimal(5, 2)
  subtotal          Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal     @default(0) @db.Decimal(14, 2)
  total             Decimal     @default(0) @db.Decimal(14, 2)
  terms             String?
  notes             String?
  priceBookId       String?
  /// the document this one was converted from (quote → order → invoice)
  sourceDocumentId  String?
  status            QuoteStatus @default(DRAFT)
  validUntil        DateTime?   @db.Date

  // ── brand-owned base mixin (brand and region are inherited from the deal) ──
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  territoryId String?
  ownerId     String
  owner       User      @relation("QuoteOwner", fields: [ownerId], references: [id])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  lines DocumentLine[]

  @@index([dealId])
  @@index([brandId, regionId])
  @@index([ownerId])
}

model SalesOrder {
  id                String      @id @default(cuid())
  /// {docPrefix}-{QT|SO|INV}-{YYYY}-{00001}; assigned by the DB trigger app_document_number() (gap-free per brand / type / year)
  number            String      @unique @default("")
  dealId            String
  deal              Deal        @relation(fields: [dealId], references: [id])
  accountId         String?
  contactId         String?
  issueDate         DateTime    @default(now()) @db.Date
  currency          String      @default("NGN")
  /// header discount in percent, applied after line discounts
  headerDiscountPct Decimal     @default(0) @db.Decimal(5, 2)
  subtotal          Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal     @default(0) @db.Decimal(14, 2)
  total             Decimal     @default(0) @db.Decimal(14, 2)
  terms             String?
  notes             String?
  priceBookId       String?
  /// the document this one was converted from (quote → order → invoice)
  sourceDocumentId  String?
  status            OrderStatus @default(DRAFT)
  expectedDelivery  DateTime?   @db.Date

  // ── brand-owned base mixin (brand and region are inherited from the deal) ──
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  territoryId String?
  ownerId     String
  owner       User      @relation("SalesOrderOwner", fields: [ownerId], references: [id])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  lines DocumentLine[]

  @@index([dealId])
  @@index([brandId, regionId])
  @@index([ownerId])
}

model Invoice {
  id                String        @id @default(cuid())
  /// {docPrefix}-{QT|SO|INV}-{YYYY}-{00001}; assigned by the DB trigger app_document_number() (gap-free per brand / type / year)
  number            String        @unique @default("")
  dealId            String
  deal              Deal          @relation(fields: [dealId], references: [id])
  accountId         String?
  contactId         String?
  issueDate         DateTime      @default(now()) @db.Date
  currency          String        @default("NGN")
  /// header discount in percent, applied after line discounts
  headerDiscountPct Decimal       @default(0) @db.Decimal(5, 2)
  subtotal          Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(14, 2)
  total             Decimal       @default(0) @db.Decimal(14, 2)
  terms             String?
  notes             String?
  priceBookId       String?
  /// the document this one was converted from (quote → order → invoice)
  sourceDocumentId  String?
  status            InvoiceStatus @default(DRAFT)
  dueDate           DateTime?     @db.Date
  amountPaid        Decimal       @default(0) @db.Decimal(14, 2)

  // ── brand-owned base mixin (brand and region are inherited from the deal) ──
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  territoryId String?
  ownerId     String
  owner       User      @relation("InvoiceOwner", fields: [ownerId], references: [id])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  lines    DocumentLine[]
  payments Payment[]

  @@index([dealId])
  @@index([brandId, regionId])
  @@index([ownerId])
}

/// Line of exactly one document. RLS: visible when its document is.
model DocumentLine {
  id           String      @id @default(cuid())
  quoteId      String?
  quote        Quote?      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  invoiceId    String?
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position     Int
  /// must be a product of the document's brand
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id])
  description  String
  qty          Decimal     @db.Decimal(12, 2)
  unitPrice    Decimal     @db.Decimal(14, 2)
  discountPct  Decimal     @default(0) @db.Decimal(5, 2)
  taxRate      Decimal     @default(7.5) @db.Decimal(5, 2)
  /// qty × unitPrice less the line discount (before header discount and tax)
  lineTotal    Decimal     @db.Decimal(14, 2)
  vin          String?

  @@index([quoteId])
  @@index([salesOrderId])
  @@index([invoiceId])
}

/// Receipt against an invoice (deposit / balance). RLS: visible when the invoice is.
model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(14, 2)
  /// CASH | TRANSFER | POS | CHEQUE | FINANCE
  method       String
  reference    String?
  receivedAt   DateTime @default(now())
  receivedById String?
  createdAt    DateTime @default(now())

  @@index([invoiceId])
}

/// Gap-free document numbering: one row per brand / type / year, locked by the numbering trigger.
model DocumentCounter {
  brandId String
  type    String
  year    Int
  last    Int    @default(0)

  @@id([brandId, type, year])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Approval request of the approval engine (prompt 08). Brand-owned: brand of the record, owner = requester.
model ApprovalRequest {
  id           String           @id @default(cuid())
  /// = process key: DISCOUNT | BRAND_CHANGE | OWNER_TRANSFER | custom
  kind         String
  entity       String
  entityId     String
  status       ApprovalStatus   @default(PENDING)
  /// 1 = Brand Manager, 2 = Head of Sales
  level        Int              @default(1)
  processId    String?
  process      ApprovalProcess? @relation(fields: [processId], references: [id])
  /// order of the step currently waiting for a decision
  currentStep  Int              @default(1)
  /// what is applied on approval, e.g. { newBrandId, newRegionId, newOwnerId }
  payload      Json             @default("{}")
  /// [{ at, userId, userName, action, note }]
  comments     Json             @default("[]")
  title        String           @default("")
  tasks        ApprovalTask[]
  approverId   String?
  approver     User?            @relation("ApprovalApprover", fields: [approverId], references: [id])
  reason       String?
  decidedAt    DateTime?
  decisionNote String?

  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  territoryId String?
  ownerId     String
  owner       User      @relation("ApprovalOwner", fields: [ownerId], references: [id])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([entity, entityId])
  @@index([approverId, status])
  @@index([brandId, regionId])
}

/// Outbox of domain events (e.g. document.confirmed) for integrations (prompt 13). Written by the system only.
model DomainEvent {
  id          String    @id @default(cuid())
  name        String
  brandId     String?
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt, createdAt])
}

// ───────────────────────── Activities, test drives, notifications (prompt 07) ─────────────────────────

enum ActivityType {
  TASK
  CALL
  MEETING
  TEST_DRIVE
  EMAIL_LOG
  WHATSAPP_LOG
  SMS_LOG
}

enum ActivityStatus {
  OPEN
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Brand-owned: brand and region are copied from the parent record (lead, deal, case; an account needs a brand context).
model Activity {
  id             String         @id @default(cuid())
  type           ActivityType
  /// Lead | Deal | Account | Case
  parentType     String
  parentId       String
  subject        String
  description    String?
  /// tasks: due date; calls: time of the call
  dueAt          DateTime?
  /// meetings / test drives
  startAt        DateTime?
  endAt          DateTime?
  status         ActivityStatus @default(OPEN)
  /// LOW | NORMAL | HIGH
  priority       String         @default("NORMAL")
  /// { users: string[], contacts: string[] }
  participants   Json           @default("{}")
  outcome        String?
  reminderAt     DateTime?
  reminderSentAt DateTime?
  /// RRULE (tasks / meetings); the next occurrence is created when one is completed
  recurrence     String?
  completedAt    DateTime?
  // call
  direction      String?
  durationSec    Int?
  phone          String?
  recordingUrl   String?
  disposition    String?

  // ── brand-owned base mixin ──
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  territoryId String?
  ownerId     String
  owner       User      @relation("ActivityOwner", fields: [ownerId], references: [id])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  testDrive TestDrive?

  @@index([parentType, parentId])
  @@index([ownerId, status])
  @@index([brandId, regionId])
  @@index([startAt])
  @@index([dueAt])
}

/// Test-drive details (1:1 with an Activity of type TEST_DRIVE). RLS: visible when the activity is.
/// brandId / startAt / endAt / cancelled are copies used by the double-booking trigger app_test_drive_no_overlap().
model TestDrive {
  activityId            String    @id
  activity              Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  brandId               String
  /// demo model – must be a product of the activity's brand
  productId             String?
  product               Product?  @relation(fields: [productId], references: [id])
  vehicleVin            String?
  vehiclePlate          String?
  /// SHOWROOM | HOME | OTHER
  location              String    @default("SHOWROOM")
  licenceChecked        Boolean   @default(false)
  /// sensitive: shown to the owner, managers and management only
  licenceNumber         String?
  indemnitySigned       Boolean   @default(false)
  indemnityAttachmentId String?
  odometerStart         Int?
  odometerEnd           Int?
  feedbackRating        Int?
  followUpAt            DateTime?
  startAt               DateTime
  endAt                 DateTime
  cancelled             Boolean   @default(false)

  @@index([brandId, vehicleVin])
}

/// In-app notification for one user (reminders, mentions, approvals …). RLS: only the recipient.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// REMINDER | MENTION | ASSIGNED | APPROVAL | INFO
  kind      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// ───────────────────────── Approvals & workflow automation (prompt 08) ─────────────────────────

enum ApproverType {
  BRAND_MANAGER_OF_RECORD
  BRAND_MANAGER_OF_NEW_BRAND
  ROLE
  USER
  RSM
}

/// Approval process: which records need approval (criteria) and who decides (steps).
model ApprovalProcess {
  id        String            @id @default(cuid())
  /// DISCOUNT | BRAND_CHANGE | OWNER_TRANSFER | custom key
  key       String            @unique
  name      String
  /// module key (quotes, deals, leads) or * for any brand-owned record
  module    String
  /// NULL = all brands
  brandId   String?
  brand     Brand?            @relation(fields: [brandId], references: [id])
  /// criteria tree evaluated on the request facts ({} = always)
  criteria  Json              @default("{}")
  active    Boolean           @default(true)
  steps     ApprovalStep[]
  requests  ApprovalRequest[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

/// Steps with the same order run in parallel; steps sharing a slot are alternatives (any one approver decides).
model ApprovalStep {
  id                    String          @id @default(cuid())
  processId             String
  process               ApprovalProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  order                 Int
  slot                  String?
  approverType          ApproverType
  /// ROLE: role name
  roleName              String?
  /// USER: user id
  userId                String?
  /// criteria tree on the request facts; the step is skipped when it does not match
  condition             Json?
  autoApproveAfterHours Int?

  @@index([processId, order])
}

/// One approver's pending decision. Readable by the approver and by users who can see the record.
model ApprovalTask {
  id            String          @id @default(cuid())
  requestId     String
  request       ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder     Int
  slot          String
  approverId    String
  approver      User            @relation("ApprovalTaskApprover", fields: [approverId], references: [id])
  status        ApprovalStatus  @default(PENDING)
  note          String?
  decidedAt     DateTime?
  autoApproveAt DateTime?
  // denormalised from the request: lets an approver of ANOTHER brand (brand change) see what they decide
  kind          String
  title         String
  summary       String?
  entity        String
  entityId      String
  brandId       String
  regionId      String
  requesterId   String
  requesterName String
  createdAt     DateTime        @default(now())

  @@index([approverId, status])
  @@index([requestId])
}

enum WorkflowTrigger {
  ON_CREATE
  ON_EDIT
  FIELD_CHANGE
  DATE_BASED
  SCHEDULED
}

/// Workflow rule: trigger + criteria + actions. brandId NULL = all brands; a brand rule never touches other brands.
model WorkflowRule {
  id            String          @id @default(cuid())
  /// stable key of seeded rules
  key           String?         @unique
  name          String
  description   String?
  /// leads | deals | quotes | salesOrders
  module        String
  trigger       WorkflowTrigger
  /// FIELD_CHANGE: { field } · DATE_BASED: { dateField, offsetDays } · SCHEDULED: { repeat: ONCE | PER_UPDATE }
  triggerConfig Json            @default("{}")
  brandId       String?
  brand         Brand?          @relation(fields: [brandId], references: [id])
  criteria      Json            @default("{}")
  actions       Json            @default("[]")
  active        Boolean         @default(true)
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([module, trigger, active])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  DEAD
}

/// Job queue on Postgres (FOR UPDATE SKIP LOCKED) with retries and idempotency keys. System-only table.
model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json      @default("{}")
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  /// a second enqueue with the same key is a no-op
  idempotencyKey String?   @unique
  lastError      String?
  result         Json?
  brandId        String?
  ruleId         String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, runAt])
  @@index([ruleId, createdAt])
}

// ───────────────────────── Reports, dashboards, forecasts & targets (prompt 09) ─────────────────────────

enum ReportFolder {
  PRIVATE
  BRAND
  GROUP
}

/// Saved report. Sharing (folder) only decides who can OPEN the definition – it always runs with the viewer's access.
model Report {
  id          String       @id @default(cuid())
  /// stable key of the seeded standard reports
  key         String?      @unique
  name        String
  description String?
  /// deals | leads | quotes | activities
  module      String
  /// columns, filters, date range, grouping, summaries, chart (src/server/modules/reports/definition.ts)
  definition  Json
  folder      ReportFolder @default(PRIVATE)
  /// folder BRAND: shared with the users of this brand
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id])
  /// NULL = standard report
  ownerId     String?
  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([folder, brandId])
  @@index([ownerId])
}

enum PeriodType {
  MONTH
  QUARTER
}

/// Sales target for a period at brand, brand-region or user level (set by Head of Sales / the Brand Manager).
model Target {
  id          String     @id @default(cuid())
  periodType  PeriodType
  /// first day of the month / quarter
  periodStart DateTime   @db.Date
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id])
  /// NULL = whole brand
  regionId    String?
  region      Region?    @relation(fields: [regionId], references: [id])
  /// set = target of one sales exec (regionId is then set too)
  userId      String?
  user        User?      @relation("TargetUser", fields: [userId], references: [id], onDelete: Cascade)
  units       Int        @default(0)
  revenue     Decimal    @default(0) @db.Decimal(16, 2)
  createdById String?
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([periodType, periodStart, brandId])
}

/// Manager's commit / adjustment note on a forecast line.
model ForecastNote {
  id          String     @id @default(cuid())
  periodType  PeriodType
  periodStart DateTime   @db.Date
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id])
  regionId    String?
  /// the exec the note is about (optional)
  userId      String?
  /// manager's adjustment of the forecast amount (+ / -)
  adjustment  Decimal?   @db.Decimal(16, 2)
  note        String
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([periodType, periodStart, brandId])
}

// ───────────────────────── Communications: messages, templates, campaigns (prompt 10) ─────────────────────────

enum Channel {
  EMAIL
  SMS
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  FAILED
  /// not sent: the recipient has no marketing consent for the brand (or opted out)
  SUPPRESSED
  RECEIVED
}

/// One outbound or inbound message. Brand-owned: brand and region of the record it belongs to.
model Message {
  id                String        @id @default(cuid())
  channel           Channel
  /// OUT | IN
  direction         String
  status            MessageStatus @default(QUEUED)
  /// Lead | Deal
  parentType        String
  parentId          String
  activityId        String?
  contactId         String?
  campaignId        String?
  campaignMemberId  String?
  templateId        String?
  /// sender identity actually used (brand from-address, sender ID or WhatsApp number)
  fromAddress       String
  toAddress         String
  subject           String?
  body              String
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?

  // ── brand-owned base mixin ──
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  territoryId String?
  ownerId     String
  owner       User      @relation("MessageOwner", fields: [ownerId], references: [id])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([parentType, parentId])
  @@index([providerMessageId])
  @@index([brandId, regionId])
  @@index([campaignId])
}

/// Message template. brandId NULL = group template (managed by management / administrators).
model Template {
  id             String   @id @default(cuid())
  brandId        String?
  brand          Brand?   @relation(fields: [brandId], references: [id])
  channel        Channel
  name           String
  subject        String?
  /// merge fields: {{contact.firstName}}, {{deal.model}}, {{brand.name}}, {{owner.name}}, {{unsubscribeUrl}} …
  body           String
  /// WhatsApp: NOT_SUBMITTED | PENDING | APPROVED | REJECTED (business-initiated messages need an approved template)
  whatsappStatus String   @default("NOT_SUBMITTED")
  /// name of the template registered with WhatsApp
  whatsappName   String?
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns Campaign[]

  @@index([brandId, channel])
}

enum CampaignType {
  LAUNCH
  PROMO
  SERVICE_REMINDER
  EVENT
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  CANCELLED
}

/// Marketing campaign of ONE brand (brand-tagged).
model Campaign {
  id          String         @id @default(cuid())
  /// short code for attribution (web-to-lead "campaign" field / utm_campaign)
  code        String         @unique
  brandId     String
  brand       Brand          @relation(fields: [brandId], references: [id])
  name        String
  type        CampaignType   @default(PROMO)
  channel     Channel
  budget      Decimal?       @db.Decimal(14, 2)
  startDate   DateTime?      @db.Date
  endDate     DateTime?      @db.Date
  status      CampaignStatus @default(DRAFT)
  templateId  String?
  template    Template?      @relation(fields: [templateId], references: [id])
  /// { kind: ALL_LEADS | ALL_CUSTOMERS | REPORT, reportId? }
  audience    Json           @default("{}")
  ownerId     String
  createdById String?
  launchedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  members CampaignMember[]
  leads   Lead[]
  deals   Deal[]

  @@index([brandId, status])
}

enum MemberStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  RESPONDED
  UNSUBSCRIBED
  FAILED
  SUPPRESSED
}

model CampaignMember {
  id               String       @id @default(cuid())
  campaignId       String
  campaign         Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId        String?
  contact          Contact?     @relation(fields: [contactId], references: [id])
  leadId           String?
  lead             Lead?        @relation(fields: [leadId], references: [id])
  /// the deal that links a contact to the brand (messages to contacts are logged on it)
  dealId           String?
  name             String
  address          String
  status           MemberStatus @default(PENDING)
  /// why the member was suppressed / failed
  reason           String?
  messageId        String?
  unsubscribeToken String       @unique
  sentAt           DateTime?
  updatedAt        DateTime     @updatedAt

  @@unique([campaignId, address])
  @@index([campaignId, status])
}

// ───────────────────────── Cases: customer care & complaints (prompt 11) ─────────────────────────

enum CaseType {
  COMPLAINT
  ENQUIRY
  DELIVERY_ISSUE
  WARRANTY
  DOCUMENTATION
  BILLING
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CaseChannel {
  PHONE
  EMAIL
  WHATSAPP
  WALK_IN
  WEB
}

enum CaseStatus {
  NEW
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

/// Customer-care case. Brand-owned; number {docPrefix}-CS-{YYYY}-{00001} assigned by DB trigger (per brand and year).
model Case {
  id                 String       @id @default(cuid())
  number             String       @unique @default("")
  accountId          String?
  account            Account?     @relation(fields: [accountId], references: [id])
  contactId          String?
  contact            Contact?     @relation(fields: [contactId], references: [id])
  dealId             String?
  deal               Deal?        @relation(fields: [dealId], references: [id])
  salesOrderId       String?
  vin                String?
  type               CaseType     @default(ENQUIRY)
  priority           CasePriority @default(MEDIUM)
  channel            CaseChannel  @default(PHONE)
  subject            String
  description        String?
  status             CaseStatus   @default(NEW)
  /// customer name / phone / email as given when no contact is linked (web form, inbound message)
  customerName       String?
  customerPhone      String?
  customerEmail      String?
  /// true while nobody has taken the case (it is parked with the brand's manager)
  unassigned         Boolean      @default(false)
  // ── SLA (business hours of the group calendar) ──
  firstResponseDueAt DateTime?
  firstRespondedAt   DateTime?
  /// resolution due
  slaDueAt           DateTime?
  escalatedAt        DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  resolution         String?
  satisfactionScore  Int?
  satisfactionNote   String?
  /// token of the satisfaction survey link sent on close
  surveyToken        String?      @unique
  surveySentAt       DateTime?

  // ── brand-owned base mixin ──
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id])
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  territoryId String?
  ownerId     String
  owner       User      @relation("CaseOwner", fields: [ownerId], references: [id])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([brandId, regionId])
  @@index([ownerId, status])
  @@index([status, slaDueAt])
  @@index([accountId])
  @@index([dealId])
}

/// SLA per brand and priority (business hours).
model SlaPolicy {
  id                 String       @id @default(cuid())
  brandId            String
  brand              Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  priority           CasePriority
  firstResponseHours Int
  resolutionHours    Int
  /// role notified when the SLA is breached (default: Brand Manager)
  escalateToRole     String       @default("Brand Manager")
  updatedAt          DateTime     @updatedAt

  @@unique([brandId, priority])
}

/// Knowledge article. brandId NULL = group article (visible to everyone); brand articles only to that brand's users.
model Solution {
  id          String   @id @default(cuid())
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id])
  title       String
  body        String
  tags        String[] @default([])
  published   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId, published])
}

/// Business hours of the group (Africa/Lagos) – one row, id "default". SLA timers only run inside them.
model BusinessHours {
  id        String   @id @default("default")
  /// ISO weekdays that are working days (1 = Monday … 7 = Sunday)
  workDays  Int[]    @default([1, 2, 3, 4, 5, 6])
  /// "08:00" / "17:00" Lagos time
  opensAt   String   @default("08:00")
  closesAt  String   @default("17:00")
  updatedAt DateTime @updatedAt
}

/// Public holiday (no SLA time runs on it).
model Holiday {
  date DateTime @id @db.Date
  name String
}
